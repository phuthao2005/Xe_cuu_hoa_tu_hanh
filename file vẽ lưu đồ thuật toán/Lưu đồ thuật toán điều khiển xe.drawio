        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Khai báo các lớp màu sắc chuẩn báo cáo\n    classDef startEnd fill:#e0e0e0,stroke:#333333,stroke-width:2px,color:#000000,font-weight:bold;\n    classDef ioNode fill:#bbdefb,stroke:#1565c0,stroke-width:1.5px,color:#000000;\n    classDef decisionNode fill:#fff9c4,stroke:#fbc02d,stroke-width:1.5px,color:#000000,font-weight:bold;\n    classDef straightNode fill:#c8e6c9,stroke:#2e7d32,stroke-width:1.5px,color:#000000;\n    classDef turnNode fill:#ffe0b2,stroke:#ef6c00,stroke-width:1.5px,color:#000000;\n    classDef stopNode fill:#ffcdd2,stroke:#c62828,stroke-width:1.5px,color:#000000;\n\n    Start([BẮT ĐẦU]):::startEnd --&gt; ReceiveCmd[/Nhận lệnh di chuyển từ Khối Xử lý/]:::ioNode\n    ReceiveCmd --&gt; CheckCmd{Mã lệnh di chuyển là gì?}:::decisionNode\n\n    %% TIẾN THẲNG\n    CheckCmd -- TIẾN THẲNG --&gt; Fwd[Lệnh move_forward]:::straightNode\n    Fwd --&gt; FwdSet[Xuất xung PWM = SPD_FWD 60%&lt;br/&gt;IN1=HIGH, IN4=HIGH, IN6=HIGH, IN7=HIGH&lt;br/&gt;IN2=LOW, IN3=LOW, IN5=LOW, IN8=LOW]:::straightNode\n    FwdSet --&gt; End([KẾT THÚC / CHUYỂN TRẠNG THÁI]):::startEnd\n\n    %% LÙI XE\n    CheckCmd -- LÙI XE --&gt; Bwd[Lệnh move_backward]:::straightNode\n    Bwd --&gt; BwdSet[Xuất xung PWM = SPD_FWD 60%&lt;br/&gt;IN2=HIGH, IN3=HIGH, IN5=HIGH, IN8=HIGH&lt;br/&gt;IN1=LOW, IN4=LOW, IN6=LOW, IN7=LOW]:::straightNode\n    BwdSet --&gt; End\n\n    %% XOAY TRÁI TẠI CHỖ\n    CheckCmd -- XOAY TRÁI TẠI CHỖ --&gt; TurnLPivot[Lệnh turn_left_pivot]:::turnNode\n    TurnLPivot --&gt; TurnLPivotSet[Xuất xung PWM = SPD_TURN 80%&lt;br/&gt;Bánh Trái quay LÙI: IN2=HIGH, IN3=HIGH&lt;br/&gt;Bánh Phải quay TIẾN: IN6=HIGH, IN7=HIGH]:::turnNode\n    TurnLPivotSet --&gt; End\n\n    %% XOAY PHẢI TẠI CHỖ\n    CheckCmd -- XOAY PHẢI TẠI CHỖ --&gt; TurnRPivot[Lệnh turn_right_pivot]:::turnNode\n    TurnRPivot --&gt; TurnRPivotSet[Xuất xung PWM = SPD_TURN 80%&lt;br/&gt;Bánh Trái quay TIẾN: IN1=HIGH, IN4=HIGH&lt;br/&gt;Bánh Phải quay LÙI: IN5=HIGH, IN8=HIGH]:::turnNode\n    TurnRPivotSet --&gt; End\n\n    %% LƯỢN NÉ SANG TRÁI\n    CheckCmd -- LƯỢN NÉ TRÁI --&gt; SteerLSoft[Lệnh steer_left_soft]:::turnNode\n    SteerLSoft --&gt; SteerLSoftSet[Bánh Trái giảm tốc: PWM = SPD_SOFT_IN 40%&lt;br/&gt;Bánh Phải tăng tốc: PWM = SPD_SOFT_OUT 85%]:::turnNode\n    SteerLSoftSet --&gt; End\n\n    %% LƯỢN NÉ SANG PHẢI\n    CheckCmd -- LƯỢN NÉ PHẢI --&gt; SteerRSoft[Lệnh steer_right_soft]:::turnNode\n    SteerRSoft --&gt; SteerRSoftSet[Bánh Trái tăng tốc: PWM = SPD_SOFT_OUT 85%&lt;br/&gt;Bánh Phải giảm tốc: PWM = SPD_SOFT_IN 40%]:::turnNode\n    SteerRSoftSet --&gt; End\n\n    %% DỪNG XE\n    CheckCmd -- DỪNG XE --&gt; Stop[Lệnh stop_robot]:::stopNode\n    Stop --&gt; StopSet[Xuất duty_u16 = 0 cho cả 8 chân IN1..IN8&lt;br/&gt;Ngắt toàn bộ công suất động cơ]:::stopNode\n    StopSet --&gt; End&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="XlnUP0APU1YkB7ypW4tX-43">
