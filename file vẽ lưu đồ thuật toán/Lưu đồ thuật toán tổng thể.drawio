  <diagram name="Trang-1" id="yDM3VohFPzNzY4PaaRzm">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="827" background="light-dark(#ffffff, #121212)" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;theme&#39;: &#39;default&#39;, &#39;themeVariables&#39;: { &#39;lineColor&#39;: &#39;#2b2b2b&#39;}}}%%\ngraph TD\n    classDef startEnd fill:#e0e0e0,stroke:#333,stroke-width:2px,color:#000,font-weight:bold;\n    classDef inputOutput fill:#bbdefb,stroke:#1976d2,stroke-width:1.5px,color:#000;\n    classDef decision fill:#fff9c4,stroke:#fbc02d,stroke-width:1.5px,color:#000,font-weight:bold;\n    classDef fireAction fill:#ffcdd2,stroke:#d32f2f,stroke-width:1.5px,color:#000;\n    classDef moveAction fill:#c8e6c9,stroke:#388e3c,stroke-width:1.5px,color:#000;\n    classDef estopAction fill:#ff8a80,stroke:#b71c1c,stroke-width:2px,color:#000,font-weight:bold;\n\n    Start([BẮT ĐẦU]):::startEnd --&gt; InitWifi[Khởi tạo Wi-Fi AP &amp; Async Web Server Port 80]:::moveAction\n    InitWifi --&gt; Init[Khởi tạo PWM, GPIO, ADC, Relay &amp; Servo]:::moveAction\n    Init --&gt; ResetState[Tắt động cơ - Tắt bơm - Servo 90 deg]:::moveAction\n    ResetState --&gt; ReadFlame[/Đọc 3 cảm biến lửa IR/]:::inputOutput\n\n    %% KIỂM TRA DỪNG KHẨN CẤP (E-STOP)\n    ReadFlame --&gt; CheckEStop{Nút E-Stop được kích hoạt?&lt;br/&gt;estop_active == True}:::decision\n    CheckEStop -- Đúng --&gt; HaltAll[DỪNG TẤT CẢ ĐỘNG CƠ&lt;br/&gt;Tắt máy bơm 5V&lt;br/&gt;Cập nhật state = ESTOP]:::estopAction\n    HaltAll --&gt; Delay10[Đợi 10ms]:::moveAction\n\n    %% KHỐI DẬP LỬA\n    CheckEStop -- Sai --&gt; CheckFire{Có cảm biến lửa &lt; 1500?}:::decision\n    CheckFire -- Có lửa --&gt; StopFire[Dừng xe ngay lập tức]:::fireAction\n    StopFire --&gt; PumpOn[Bật máy bơm 5V]:::fireAction\n    PumpOn --&gt; CheckPos{Vị trí ngọn lửa?}:::decision\n\n    CheckPos -- Giữa --&gt; Servo90[Xoay Servo 90 deg]:::fireAction\n    CheckPos -- Trái --&gt; Servo135[Xoay Servo 135 deg]:::fireAction\n    CheckPos -- Phải --&gt; Servo45[Xoay Servo 45 deg]:::fireAction\n\n    Servo90 --&gt; UpdateWebFire[Cập nhật State EXTINGUISH lên Web]:::inputOutput\n    Servo135 --&gt; UpdateWebFire\n    Servo45 --&gt; UpdateWebFire\n    UpdateWebFire --&gt; Delay10\n\n    %% KHỐI NÉ VẬT CẢN &amp; DI CHUYỂN\n    CheckFire -- Không lửa --&gt; PumpOff[Tắt máy bơm 5V]:::moveAction\n    PumpOff --&gt; ServoReset[Servo về 90 deg]:::moveAction\n    ServoReset --&gt; ReadUS[/Đọc 3 cảm biến siêu âm HC-SR04/]:::inputOutput\n\n    ReadUS --&gt; Case1{Kẹt khẩn cấp?&lt;br/&gt;Center &lt; 18cm hoặc 2 bên &lt; 30cm}:::decision\n\n    %% TH1: Kẹt khẩn cấp\n    Case1 -- Đúng --&gt; EmgStop[Dừng 100ms -&gt; Lùi 450ms -&gt; Dừng 100ms]:::moveAction\n    EmgStop --&gt; CheckDiff{Khoảng cách 2 bên tương đương?}:::decision\n\n    CheckDiff -- Đúng --&gt; CheckLastDir{Hướng nhớ trước đó?}:::decision\n    CheckLastDir -- LEFT --&gt; TurnL1[Xoay Trái 420ms]:::moveAction\n    CheckLastDir -- RIGHT --&gt; TurnR1[Xoay Phải 420ms]:::moveAction\n\n    CheckDiff -- Sai --&gt; CheckLR{Left &gt; Right?}:::decision\n    CheckLR -- Đúng --&gt; TurnL2[Xoay Trái 420ms - Nhớ LEFT]:::moveAction\n    CheckLR -- Sai --&gt; TurnR2[Xoay Phải 420ms - Nhớ RIGHT]:::moveAction\n\n    TurnL1 --&gt; StopPivotEnd[Dừng xe 80ms]:::moveAction\n    TurnR1 --&gt; StopPivotEnd\n    TurnL2 --&gt; StopPivotEnd\n    TurnR2 --&gt; StopPivotEnd\n    StopPivotEnd --&gt; UpdateWebAvoid[Cập nhật State AVOID lên Web]:::inputOutput\n\n    %% TH2: Cảnh báo chính diện\n    Case1 -- Sai --&gt; Case2{Vật cản chính diện?&lt;br/&gt;Center &lt; 30cm}:::decision\n    Case2 -- Đúng --&gt; WarnStop[Dừng 50ms]:::moveAction\n    WarnStop --&gt; CheckLRWarn{Left &gt;= Right?}:::decision\n    CheckLRWarn -- Đúng --&gt; TurnLWarn[Xoay Trái 300ms - Nhớ LEFT]:::moveAction\n    CheckLRWarn -- Sai --&gt; TurnRWarn[Xoay Phải 300ms - Nhớ RIGHT]:::moveAction\n    TurnLWarn --&gt; StopWarnEnd[Dừng xe 50ms]:::moveAction\n    TurnRWarn --&gt; StopWarnEnd\n    StopWarnEnd --&gt; UpdateWebAvoid\n\n    %% TH3 &amp; 4: Vướng lệch\n    Case2 -- Sai --&gt; Case3{Vướng Trái?&lt;br/&gt;Left &lt; 30cm}:::decision\n    Case3 -- Đúng --&gt; SteerR[Lượn Phải - Nhớ RIGHT]:::moveAction\n\n    Case3 -- Sai --&gt; Case4{Vướng Phải?&lt;br/&gt;Right &lt; 30cm}:::decision\n    Case4 -- Đúng --&gt; SteerL[Lượn Trái - Nhớ LEFT]:::moveAction\n\n    %% TH5: Tiến thẳng\n    Case4 -- Sai --&gt; MoveForward[Tiến thẳng 60%]:::moveAction\n\n    SteerR --&gt; UpdateWebAvoid\n    SteerL --&gt; UpdateWebAvoid\n    MoveForward --&gt; UpdateWebPatrol[Cập nhật State PATROL lên Web]:::inputOutput\n\n    UpdateWebAvoid --&gt; Delay10\n    UpdateWebPatrol --&gt; Delay10\n\n    Delay10 --&gt; ReadFlame&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="jCCzsaV-UrpvnlCEzRxz-756">
