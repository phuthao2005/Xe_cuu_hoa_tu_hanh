        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Khai báo lớp màu sắc chuẩn báo cáo UET\n    classDef startEnd fill:#e0e0e0,stroke:#333333,stroke-width:2px,color:#000000,font-weight:bold;\n    classDef ioNode fill:#bbdefb,stroke:#1565c0,stroke-width:1.5px,color:#000000;\n    classDef decisionNode fill:#fff9c4,stroke:#fbc02d,stroke-width:1.5px,color:#000000,font-weight:bold;\n    classDef processNode fill:#e8f5e9,stroke:#2e7d32,stroke-width:1.5px,color:#000000;\n    classDef fireNode fill:#ffcdd2,stroke:#c62828,stroke-width:1.5px,color:#000000,font-weight:bold;\n\n    Start([BẮT ĐẦU: Hàm Dò tìm Lửa]):::startEnd --&gt; ReadADC[/Đọc giá trị ADC 3 cảm biến IR&lt;br/&gt;val_l: GPIO34, val_c: GPIO35, val_r: GPIO36/]:::ioNode\n    ReadADC --&gt; CheckThreshold{Bất kỳ cảm biến nào có&lt;br/&gt;giá trị ADC &lt; 1500?}:::decisionNode\n\n    %% TRƯỜNG HỢP CÓ LỬA (ADC &lt; 1500)\n    CheckThreshold -- ĐÚNG: Phát hiện lửa --&gt; SetFireFlag[Xác nhận Cờ báo có lửa: Fire_Detected = True]:::fireNode\n    SetFireFlag --&gt; CheckPosition{Phân tích vị trí cảm biến&lt;br/&gt;có giá trị ADC nhỏ nhất}:::decisionNode\n\n    CheckPosition -- val_c &lt; 1500 --&gt; PosCenter[Xác định vị trí: LỬA Ở GIỮA&lt;br/&gt;Ghi nhớ trạng thái = CENTER]:::fireNode\n    CheckPosition -- val_l &lt; 1500 --&gt; PosLeft[Xác định vị trí: LỬA BÊN TRÁI&lt;br/&gt;Ghi nhớ trạng thái = LEFT]:::fireNode\n    CheckPosition -- val_r &lt; 1500 --&gt; PosRight[Xác định vị trí: LỬA BÊN PHẢI&lt;br/&gt;Ghi nhớ trạng thái = RIGHT]:::fireNode\n\n    PosCenter --&gt; EndFire([Truyền dữ liệu vị trí sang Khối Dập Lửa]):::startEnd\n    PosLeft --&gt; EndFire\n    PosRight --&gt; EndFire\n\n    %% TRƯỜNG HỢP KHÔNG CÓ LỬA (ADC &gt;= 1500)\n    CheckThreshold -- SAI: Không có lửa --&gt; ClearFireFlag[Cài đặt Cờ báo lửa: Fire_Detected = False]:::processNode\n    ClearFireFlag --&gt; EndNoFire([Chuyển điều khiển sang Khối Tránh Vật Cản]):::startEnd&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="bmVnXiVNMIX9rVd_GYXP-1">
