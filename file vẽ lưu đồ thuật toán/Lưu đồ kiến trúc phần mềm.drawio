        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;theme&#39;: &#39;default&#39;, &#39;themeVariables&#39;: { &#39;lineColor&#39;: &#39;#2b2b2b&#39;}}}%%\ngraph TD\n    classDef startEnd fill:#e0e0e0,stroke:#333,stroke-width:2px,color:#000,font-weight:bold;\n    classDef ioNode fill:#bbdefb,stroke:#1976d2,stroke-width:1.5px,color:#000;\n    classDef decision fill:#fff9c4,stroke:#fbc02d,stroke-width:1.5px,color:#000,font-weight:bold;\n    classDef process fill:#c8e6c9,stroke:#388e3c,stroke-width:1.5px,color:#000;\n    classDef errNode fill:#ffcdd2,stroke:#d32f2f,stroke-width:1.5px,color:#000;\n\n    Start([BẮT ĐẦU: Cấp nguồn / Reset ESP32]):::startEnd --&gt; Import[Nạp các thư viện: uasyncio, time, web_server, robot_control]:::process\n    Import --&gt; InitWifi[Khởi tạo Wi-Fi Access Point: SSID &#39;Robot_CuuHoa_ESP32&#39;]:::ioNode\n    InitWifi --&gt; RunMainAsync[Kích hoạt hàm bất đồng bộ main]:::process\n\n    RunMainAsync --&gt; Task1[Tác vụ 1: Khởi động Web Server Port 80&lt;br/&gt;asyncio.start_server]:::process\n    RunMainAsync --&gt; Task2[Tác vụ 2: Tạo Task điều khiển xe ngầm&lt;br/&gt;asyncio.create_task robot_control.robot_task]:::process\n\n    Task1 --&gt; ParallelLoop[VÒNG LẶP ĐỒNG THỜI UASYNCIO EVENT LOOP]:::startEnd\n    Task2 --&gt; ParallelLoop\n\n    ParallelLoop --&gt; ExecTask1[Web Server: Lắng nghe HTTP Request&lt;br/&gt;Phản hồi /api/status &amp; /api/estop]:::ioNode\n    ParallelLoop --&gt; ExecTask2[Robot Task: Quét cảm biến IR &amp; Siêu âm&lt;br/&gt;Thực thi điều khiển động cơ &amp; dập lửa]:::process\n\n    ExecTask1 --&gt; Yield[await asyncio.sleep]:::process\n    ExecTask2 --&gt; Yield\n    Yield --&gt; ParallelLoop\n\n    %% XỬ LÝ NGOẠI LỆ &amp; AN TOÀN\n    ParallelLoop -.-&gt;|Bắt lỗi KeyboardInterrupt / Exception| CatchErr{Có lỗi hệ thống?}:::decision\n    CatchErr -- Có --&gt; StopHW[DỪNG TẤT CẢ ĐỘNG CƠ&lt;br/&gt;stop_robot &amp; pump.value = 1]:::errNode\n    StopHW --&gt; End([KẾT THÚC / DỪNG AN TOÀN]):::startEnd&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="HLWe3tYSJ9MY1J0k7GnU-1">
